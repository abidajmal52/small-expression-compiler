//symbol_table.c file

#include <stdio.h>
#include <string.h>
#include "symbol_table.h"

SymbolTable global_table;
int current_scope = SCOPE_GLOBAL;

void init_symbol_table(SymbolTable *t) {
    t->count = 0;
}

int insert_symbol(SymbolTable *t, const char *name, DataType type, ScopeType scope) {
    int i = t->count++;
    strncpy(t->symbols[i].name, name, MAX_NAME - 1);
    t->symbols[i].type        = type;
    t->symbols[i].scope       = scope;
    t->symbols[i].initialized = 0;
    t->symbols[i].value.ival  = 0;
    return i;
}

Symbol *lookup_symbol(SymbolTable *t, const char *name) {
    for (int i = 0; i < t->count; i++)
        if (strcmp(t->symbols[i].name, name) == 0)
            return &t->symbols[i];
    return NULL;
}

void print_symbol_table(SymbolTable *t) {
    printf("\n============================================\n");
    printf("             SYMBOL TABLE\n");
    printf("============================================\n");
    printf("%-15s %-8s %-8s %-13s %s\n", "Name","Type","Scope","Initialized","Value");
    printf("--------------------------------------------\n");
    for (int i = 0; i < t->count; i++) {
        Symbol *s = &t->symbols[i];
        printf("%-15s %-8s %-8s %-13s ",
               s->name,
               s->type  == TYPE_INT    ? "int"    : "float",
               s->scope == SCOPE_LOCAL ? "local"  : "global",
               s->initialized          ? "yes"    : "no");
        if (s->initialized) {
            if (s->type == TYPE_FLOAT) printf("%.6g", s->value.fval);
            else                       printf("%d",   s->value.ival);
        } else {
            printf("(undef)");
        }
        printf("\n");
    }
    printf("============================================\n");
}

