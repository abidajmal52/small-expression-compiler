%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "symbol_table.h"
#include "parser.tab.h"

int line_num = 1;
int lex_errors = 0;
%}

%option noyywrap

DIGIT     [0-9]
LETTER    [a-zA-Z_]
ID        {LETTER}({LETTER}|{DIGIT})*
INT_NUM   {DIGIT}+
FLOAT_NUM {DIGIT}+\.{DIGIT}+

%%

"int"    { return INT_KW; }
"float"  { return FLOAT_KW; }
"return" { return RETURN_KW; }
"main"   { return MAIN_KW; }
"sqrt"   { return SQRT_FUNC; }
"pow"    { return POW_FUNC; }

{FLOAT_NUM} { yylval.fval = atof(yytext); return FLOAT_LITERAL; }
{INT_NUM}   { yylval.ival = atoi(yytext); return INT_LITERAL; }
{ID}        { yylval.sval = strdup(yytext); return IDENTIFIER; }

"+"  { return PLUS; }
"-"  { return MINUS; }
"*"  { return STAR; }
"/"  { return SLASH; }
"="  { return ASSIGN; }
"("  { return LPAREN; }
")"  { return RPAREN; }
"{"  { return LBRACE; }
"}"  { return RBRACE; }
";"  { return SEMICOLON; }
","  { return COMMA; }

\n       { line_num++; }
[ \t\r]+ { /* skip */ }

. {
    fprintf(stderr, "Line %d: Lexical Error - Invalid character '%s'\n", line_num, yytext);
    lex_errors++;
}

%%

